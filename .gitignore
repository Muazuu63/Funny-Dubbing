# Testing & Cache
.pytest_cache/
.coverage
htmlcov/

# Environment & Credentials
.env
.env.local
*.key
*.pem

# SQLite DB files
*.db
*.db-journal
*.sqlite
*.sqlite3

# Muazu Studio Storage
storage/models/*
!storage/models/.gitkeep
storage/projects/*
!storage/projects/.gitkeep

# Ignore heavy raw uploaded video binaries, but PERMANENTLY KEEP all learned knowledge:
storage/data/training_references/*
!storage/data/training_references/.gitkeep
temp/*
!temp/.gitkeep

# Permanent AI Knowledge & Learning Ledger (ALWAYS tracked in Git):
!storage/training_profiles/*.json
!storage/training_profiles/learning_ledger.json
!storage/training_profiles/reports/
!storage/training_profiles/reports/*.md

# Executable binaries
bin/*
!bin/.gitkeep
*.exe

# Frontend / Node
node_modules/
frontend/node_modules/
.npm
